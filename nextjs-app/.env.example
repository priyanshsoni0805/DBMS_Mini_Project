# copy to .env.local
MYSQL_HOST=localhost
MYSQL_DB=gym_management_db
# one DB account per application role (created by database/07_rbac_security.sql)
MYSQL_ADMIN_USER=gym_admin_app
MYSQL_ADMIN_PASS=ChangeMe_Admin_1!
MYSQL_TRAINER_USER=gym_trainer_app
MYSQL_TRAINER_PASS=ChangeMe_Trainer_1!
MYSQL_MEMBER_USER=gym_member_app
MYSQL_MEMBER_PASS=ChangeMe_Member_1!
MONGODB_URI=mongodb://localhost:27017
JWT_SECRET=replace-with-a-long-random-string
